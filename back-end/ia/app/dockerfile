FROM python:3.13.15-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY main.py .
COPY DTOs ./DTOs
COPY services/integration.py ./services/integration.py
COPY services/vision.py ./services/vision.py
COPY services/metals.py ./services/metals.py
COPY services/Infos ./services/Infos
COPY services/risk ./services/risk
COPY services/Predict/schema.py ./services/Predict/schema.py
COPY services/Predict/model/metals_v2/quality_model.joblib ./services/Predict/model/metals_v2/quality_model.joblib
COPY services/Predict/model/metals_v2/manifest.json ./services/Predict/model/metals_v2/manifest.json
COPY services/ComputerVision/best.onnx ./services/ComputerVision/best.onnx

EXPOSE 10000

CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-10000}"]
